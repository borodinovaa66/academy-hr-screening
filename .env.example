PORT=4173
NODE_ENV=production

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_PASSWORD_RESET=0

HR_USERNAME=hr@example.com
HR_PASSWORD=change-this-password
HR_PASSWORD_RESET=0

# Optional. Leave empty to use local analytics only.
AI_PROVIDER=yandex

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

YANDEX_GPT_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-lite

# HeadHunter API. Register the app in HeadHunter and set this redirect URI there.
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=https://hr.academy-management.ru/api/hh/oauth/callback
HH_USER_AGENT=AcademyHR/1.0 (hr@praktiki.pro)
HH_WEBHOOK_SECRET=change-this-random-token
HH_WEBHOOK_URL=https://hr.academy-management.ru/api/hh/webhook?token=change-this-random-token

# Email delivery. If SMTP_* is empty, messages are written to the communication log as pending.
APP_PUBLIC_URL=https://hr.academy-management.ru
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hr@praktiki.pro

# Telegram candidate notifications. Create bot in BotFather and set webhook to TELEGRAM_WEBHOOK_URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=change-this-random-token
TELEGRAM_WEBHOOK_URL=https://hr.academy-management.ru/api/telegram/webhook?token=change-this-random-token
